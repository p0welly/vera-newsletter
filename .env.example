# Database (provided by Railway)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Mailgun - inbound email parsing
MAILGUN_SIGNING_KEY=your-mailgun-webhook-signing-key
NEWSLETTER_FROM_ADDRESS=newsletter@yourdomain.com

# Anthropic - newsletter rewrite
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI - text-to-speech
OPENAI_API_KEY=sk-...

# Twilio - outbound phone calls
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+44...

# Resend - subscriber confirmation emails
RESEND_API_KEY=re_...
FROM_EMAIL=hello@yourdomain.com
ORG_NAME=Your Newsletter Name

# Your Railway app URL (used for Twilio TwiML callbacks)
APP_URL=https://your-app.up.railway.app

# Audio file storage - temporary public URL (see README)
AUDIO_STORAGE_URL=https://your-app.up.railway.app/audio

# Optional: restrict which sender triggers calls
TRUSTED_SENDER=editor@yourdomain.com
