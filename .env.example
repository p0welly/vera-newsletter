# Database (provided automatically by Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Mailgun — inbound email parsing
MAILGUN_SIGNING_KEY=your-mailgun-webhook-signing-key
INBOUND_DOMAIN=yourdomain.com   # domain MX records point at Mailgun

# Anthropic — newsletter rewrite
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — text-to-speech
OPENAI_API_KEY=sk-...

# Twilio — outbound phone calls
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+44...

# Resend — subscriber confirmation emails
RESEND_API_KEY=re_...
FROM_EMAIL=hello@yourdomain.com

# Admin key — used to create/manage organisations via /admin/orgs
ADMIN_KEY=make-this-a-long-random-string

# Your Railway app URL (used for Twilio TwiML callbacks and audio hosting)
APP_URL=https://your-app.up.railway.app
